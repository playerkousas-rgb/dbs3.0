# ─────────────────────────────────────────────────────────────
# DBS 3.0 多區版 — 環境變數範本
#
# 設定位置：Vercel → 你的 Project → Settings → Environment Variables
# 本檔案只作文件用途（.env.example），唔會被打包進前端 JS，
# 亦唔應該填入真實值後 commit 上 Git。
# 本機測試：複製成 .env.local 再填值（.env.local 已在 .gitignore 概念上不應上傳）。
# ─────────────────────────────────────────────────────────────

# ── 超管（Super Admin）──────────────────────────────────────
# 超管登入密碼。只存 Vercel；前端、Google Sheet、Git 都不會出現。
# 建議 20 字以上、唔同其他服務共用。
SUPER_KEY=

# （選填，建議設定）超管 session cookie 的簽名 secret。
# 未設定時會用 SUPER_KEY 派生；設定獨立值可令兩者分離。
# 產生方式：openssl rand -hex 32
SUPER_SESSION_SECRET=

# ── 各區（以下以筲箕灣區 SKW 為例；加一區就加一組）──────────
# （必填）區 API Key — 由該區 setupSystem() 產生
DBS_SKW_APIKEY=

# （選填）該區 STAFF_TOKEN（Google Sheet Config 內那個）。
# 設定後，超管在 /super 可免密鑰操作該區秘書後台（批核、證書、列印清單等）。
DBS_SKW_STAFF_KEY=

# （選填）該區 ADC_TOKEN。設定後，超管可免密鑰使用 /adc 的 ADC 審批功能。
DBS_SKW_ADC_KEY=

# ── 新區範本 ────────────────────────────────────────────────
# DBS_CHW_APIKEY=
# DBS_CHW_STAFF_KEY=
# DBS_CHW_ADC_KEY=
